# LangGraph Server（先启动 Harness_hand_write 下的 langgraph dev）
LANGGRAPH_SERVER_URL=http://127.0.0.1:2024
LANGGRAPH_GRAPH_ID=agent
# 可选；本地 langgraph dev 通常不需要
# LANGGRAPH_API_KEY=

# Web 体验账号（侧边栏登录用，与 Agent 后端无关）
WEB_USER_ID=demo_employee
WEB_PASSWORD=change-me

# 演示客户上下文（ProcurementContext.external_id）
EXTERNAL_ID=

# JWT
JWT_SECRET_KEY=change-me-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

