# To separate your traces from other application
LANGSMITH_PROJECT=new-agent
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true

# LLM providers
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# PostgresStore（与 Agent / Admin / wxsync 共用）
# DATABASE_URI=postgresql://postgres:123456@127.0.0.1:5432/sagt
# Agent Store 连接池（默认 min=1 max=10；扩并发时先加大 max，并确认 PG max_connections）
# PG_POOL_MIN_SIZE=2
# PG_POOL_MAX_SIZE=20

# OpenSandbox
# OPENSANDBOX_URL=http://127.0.0.1:8080
# OPEN_SANDBOX_API_KEY=
# 进程内预建 1 个 idle 沙箱，缩短首个新用户冷启动；无 OpenSandbox 时可设 false
# SANDBOX_PRE_WARM=true
# 沙箱出站网络策略（默认 deny + 白名单：阿里云 pip / ClawHub / ModelScope）
# SANDBOX_NETWORK_POLICY_ENABLED=true

# 主 Agent 多步协调规划（write_todos / TodoListMiddleware）
# ENABLE_WRITE_TODOS=true

# Langfuse 观测（Agent 图执行追踪）
# true/1/yes 启用；缺密钥时自动跳过且不影响主流程
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-lf-xxx
LANGFUSE_SECRET_KEY=sk-lf-xxx
# 云托管：美区 us.cloud；欧区 cloud.langfuse.com
# 自托管示例：http://192.168.111.129:3000
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# 亦可写 LANGFUSE_HOST（与 BASE_URL 二选一即可，代码会互相同步）
# LANGFUSE_HOST=https://us.cloud.langfuse.com
# 主 Agent system prompt：优先拉取 Prompt「main/system」label=production；失败回退 src/agent/memory/prompt.py

# 结构化审计日志（JSONL：who/what/tool/hitl/tokens/latency）
# 默认启用；设为 false 可关闭
# AUDIT_LOG_ENABLED=true
# 可选：覆盖默认路径（默认 src/agent/logs/audit.jsonl）
# AUDIT_LOG_PATH=src/agent/logs/audit.jsonl

# 普通日志（utils/agent_logger）
# LOG_LEVEL=INFO
# 分区覆盖：LOG_LEVEL_SANDBOX=ERROR（默认）、LOG_LEVEL_WX=DEBUG 等
# 文件落在 src/agent/logs/{main,wx,store,sandbox,middleware,observability,agent}.log

# Agent 整轮运行限制（sidebar 流式消费层保险丝；与 middleware 的 loop 限制互补）
# AGENT_RUN_LIMITS_ENABLED=true
# 全局覆盖（可选）：工具次数,秒数
# AGENT_RUN_MAX_TOOL_CALLS=80
# AGENT_RUN_MAX_SECONDS=600
# 按任务类型覆盖，例如：AGENT_RUN_LIMIT_tag_profile=60,600
# 内置默认：default(80,600) customer_query(40,300) tag_profile(60,600)
#           chat_suggest(50,600) schedule(50,600) skill_mgmt(100,900)

# 本地/演示身份上下文回退（ContextInjectionMiddleware；侧边栏通常通过 runtime context 传入）
# EXTERNAL_ID=wmE8gRKQAArnVDJ84bNuOK3KVjy_7-Wg
# OPEN_KFID=wkE8gRKQAAd4O8iGf3iB1QskRVG9BGEw
# FOLLOW_USER_ID=demo_employee
# DEMO_USER_ID=demo_employee
