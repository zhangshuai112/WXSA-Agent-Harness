### 企业微信
CORP_ID={CORP_ID}

## 企业微信自建应用
AGENT_ID={AGENT_ID}
APP_SECRET={APP_SECRET}
# 自建应用接受消息通知，授权客户联系（接收客户联系信息变更通知）
TOKEN={TOKEN}
ENCODING_AES_KEY={ENCODING_AES_KEY}
# 自建应用绑定微信客服，授权自建应用接收客服消息通知
DEFAULT_OPEN_KFID={DEFAULT_OPEN_KFID}

## 企业微信中的客户标签策略ID
TAG_STRATEGY_ID={TAG_STRATEGY_ID}

## 会话存档
# 获取会话内容的 Secret
MSGAUDIT_APP_SECRET={MSGAUDIT_APP_SECRET}
# 解密消息体的密钥 - 使用绝对路径
MSGAUDIT_PRI_KEY=D:/Harness_hand_write/wecom_wxsync/wechat_client/key/private.pem
# 解密消息体的 so 库 - Linux 部署时使用绝对路径
WeWorkFinanceSdk=/root/project/wecom_wxsync/wechat_client/lib/libWeWorkFinanceSdk_C.so

### 微信小店（和企业微信并列）
WXXD_APP_ID={WXXD_APP_ID}
WXXD_APP_SECRET={WXXD_APP_SECRET}
WXXD_TOKEN={WXXD_TOKEN}
WXXD_ENCODING_AES_KEY={WXXD_ENCODING_AES_KEY}

### 消息通知 callback 地址（域名与证书配置在 nginx）
WXQY_CALLBACK_URL=https://your-domain.com/callback/command
WXXD_CALLBACK_URL=https://your-domain.com/callback/wxxd

### Flask 回调服务
FLASK_DEBUG=False
FLASK_HOST=0.0.0.0
FLASK_PORT=8880

### PostgresStore（与 Harness_hand_write / wecom_admin 共用）
# 也可不填：会自动尝试读取 ../Harness_hand_write/.env
DATABASE_URI=postgresql://postgres:123456@127.0.0.1:5432/sagt

### notify handler（不需要接收某类通知时可注释）
FEISHU_WEBHOOK_URL={FEISHU_WEBHOOK_URL}
WXWORK_NOTIFY_USER={WXWORK_NOTIFY_USER}

